# --- Required ---
ANTHROPIC_API_KEY=
MONGO_URL=mongodb://localhost:27017
DB_NAME=opportunity_os

# --- Recommended ---
# Frontend origin(s), comma-separated. Cross-origin requests are disabled when unset.
CORS_ORIGINS=http://localhost:3000
# Random string; salts hashed IPs used as rate-limit keys.
RATE_LIMIT_IP_SALT=
# Set to 1 when deployed behind a reverse proxy (Railway/Render) so per-user
# rate limits use the real client IP from X-Forwarded-For.
TRUST_PROXY_HEADERS=

# --- Optional (defaults shown) ---
ANTHROPIC_MODEL=claude-sonnet-5
MAX_REPORTS_PER_IP_PER_DAY=15
MAX_REPORTS_PER_DAY_GLOBAL=200
REPORT_BURST_MAX=3
REPORT_BURST_WINDOW_SECS=600
